horizontal_alignment = 1

[node name="Stats" type="VBoxContainer" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="KillStat" type="Label" parent="CenterContainer/VBoxContainer/Stats"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "처치한 몬스터: 0"
