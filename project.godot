; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FreeSurvivor"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/ui/app_icon.png"

[autoload]

SkillRegistry="*res://scripts/registries/skill_registry.gd"
CharacterRegistry="*res://scripts/registries/character_registry.gd"
MonsterRegistry="*res://scripts/registries/monster_registry.gd"
GameData="*res://scripts/game_data.gd"
GameActions="*res://scripts/game_actions.gd"
UiFeedback="*res://scenes/ui/ui_feedback.gd"
HintManager="*res://scripts/hint_manager.gd"
GameManager="*res://scripts/game_manager.gd"
SceneTransition="*res://scripts/scene_transition.gd"
PlayerManager="*res://scripts/player_manager.gd"
MonsterManager="*res://scripts/monster_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
# Sensor mode avoids declaring android.hardware.screen.portrait as a required
# device feature in Google Play. The UI already switches between portrait and
# landscape layouts based on the viewport aspect ratio.
window/handheld/orientation=6

[filesystem]

import/blender/enabled=false

[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_2="Enemies"
3d_physics/layer_3="PlayerAttacks"
3d_physics/layer_4="EnemyAttacks"
3d_physics/layer_5="Pickups"
3d_physics/layer_6="Environment"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
scaling_3d/scale.android=0.8
lights_and_shadows/directional_shadow/size.android=1024
