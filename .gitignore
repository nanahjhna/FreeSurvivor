# Godot 4+ specific ignores
.godot/
/android/

# Keep source-only GLB libraries local; ship reduced runtime assets.
/assets/source/*
!/assets/source/char01/.gdignore
!/assets/source/rig/.gdignore

# Godot extracts embedded GLB images and writes import sidecars locally.
/assets/char/char01_game.glb.import
/assets/char/char01_game_*.png
/assets/char/char01_game_*.jpg
/assets/char/char01_game_*.import

# Generated Android packages.
*.aab
*.apk

# App signing keys and passwords (never commit)
*.keystore
*.jks
tools/*.pw.txt

upload-keystore.jks
upload_certificate.pem
