champion_id = "Kaisa"
champion_name = "카이사"
slot_key = "P"
reference_name = "두 번째 피부"
reference_description = "카이사는 기본 공격으로 플라즈마 중첩을 쌓아 그에 따른 추가 마법 피해를 입힙니다. 아군의 이동 불가 효과가 적에게 적용됐을 때에도 플라즈마 중첩이 쌓입니다. 살아있는 무기 효과는 카이사가 구입하는 아이템에 따라 스킬을 강화시킵니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/passive/Kaisa_Passive.png"
display_name = "두 번째 피부"
description = "카이사는 기본 공격으로 플라즈마 중첩을 쌓아 그에 따른 추가 마법 피해를 입힙니다. 아군의 이동 불가 효과가 적에게 적용됐을 때에도 플라즈마 중첩이 쌓입니다. 살아있는 무기 효과는 카이사가 구입하는 아이템에 따라 스킬을 강화시킵니다."
