reference_name = "성난 이빨 / 땅굴 파기"
reference_description = "렉사이가 대상을 물어뜯어 물리 피해를 입힙니다. 분노가 최대치일 때는 추가 고정 피해를 입힙니다. / / 매복 상태일 때 렉사이가 재사용 가능하며 오래 지속되는 땅굴을 만듭니다. 적이 이 땅굴 입구에 올라서면 파괴됩니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/RekSaiE.png"
display_name = "성난 이빨 / 땅굴 파기"
description = "렉사이가 대상을 물어뜯어 물리 피해를 입힙니다. 분노가 최대치일 때는 추가 고정 피해를 입힙니다. / / 매복 상태일 때 렉사이가 재사용 가능하며 오래 지속되는 땅굴을 만듭니다. 적이 이 땅굴 입구에 올라서면 파괴됩니다."
