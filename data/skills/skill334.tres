reference_name = "학살자의 포효"
reference_description = "사이온이 단거리 충격파를 발사해 첫 번째로 맞는 적에게 피해를 입히고 속도를 늦추며, 방어력을 낮춥니다. 충격파가 미니언이나 몬스터를 맞히면 뒤로 밀려나며 피해를 입고 둔화되며 관통하는 모든 적의 방어력을 낮춥니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/SionE.png"
display_name = "학살자의 포효"
description = "사이온이 단거리 충격파를 발사해 첫 번째로 맞는 적에게 피해를 입히고 속도를 늦추며, 방어력을 낮춥니다. 충격파가 미니언이나 몬스터를 맞히면 뒤로 밀려나며 피해를 입고 둔화되며 관통하는 모든 적의 방어력을 낮춥니다."
