champion_id = "Lissandra"
champion_name = "리산드라"
slot_key = "R"
reference_name = "얼음 무덤"
reference_description = "적 챔피언에게 시전하면 대상이 꽁꽁 얼면서 기절합니다. 리산드라에게 시전하면 몸을 어둠의 얼음으로 감싸, 공격할 수 없는 무적 상태가 된 채로 자신을 치유합니다. 그 다음 어둠의 얼음이 대상에게서 번져나가 적들에게 마법 피해를 주며 이동 속도를 늦춥니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/LissandraR.png"
display_name = "얼음 무덤"
description = "적 챔피언에게 시전하면 대상이 꽁꽁 얼면서 기절합니다. 리산드라에게 시전하면 몸을 어둠의 얼음으로 감싸, 공격할 수 없는 무적 상태가 된 채로 자신을 치유합니다. 그 다음 어둠의 얼음이 대상에게서 번져나가 적들에게 마법 피해를 주며 이동 속도를 늦춥니다."
