[resource]
script = ExtResource("1_ox157")
id = "skill296"
legacy_id = "brand_p"
champion_id = "Brand"
champion_name = "브랜드"
slot_key = "P"
reference_name = "불길"
reference_description = "브랜드의 스킬이 적을 불길로 휘감아, 4초 동안 피해를 줍니다. 불길은 세 번까지 중첩되며, 적이 불타는 동안 브랜드가 적을 처치하면 마나를 회복합니다. 챔피언이나 대형 몬스터에 불길이 세 번 중첩되면 불안정해져 2초 후 폭발하고, 근처 적에게 스킬 효과를 적용하며 막대한 피해를 입힙니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/passive/BrandP.png"
display_name = "불길"
description = "브랜드의 스킬이 적을 불길로 휘감아, 4초 동안 피해를 줍니다. 불길은 세 번까지 중첩되며, 적이 불타는 동안 브랜드가 적을 처치하면 마나를 회복합니다. 챔피언이나 대형 몬스터에 불길이 세 번 중첩되면 불안정해져 2초 후 폭발하고, 근처 적에게 스킬 효과를 적용하며 막대한 피해를 입힙니다."
