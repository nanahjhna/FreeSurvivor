[resource]
script = ExtResource("1_8c88u")
id = "skill440"
legacy_id = "aurelionsol_r"
champion_id = "AurelionSol"
champion_name = "아우렐리온 솔"
slot_key = "R"
reference_name = "유성 / 천상 강림"
reference_description = "유성: 아우렐리온 솔이 땅으로 별을 떨어뜨립니다. 이 충격으로 마법 피해를 입히고 적을 기절시키며 적중한 적 챔피언 한 명당 별가루를 획득합니다. 별가루가 어느 정도 모이면 아우렐리온 솔의 다음 유성이 천상 강림으로 변합니다. / / 천상 강림: 아우렐리온 솔이 하늘에서 충돌 범위와 피해가 커진 거대한 별을 끌어내 적을 기절시키는 대신 공중에 띄웁니다. 이후 충돌 범위 가장자리에서 충격파가 퍼지며 적중한 적에게 피해를 입히고 둔화시킵니다. 별가루는 유성과 천상 강림의 충돌 범위를 넓힙니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/AurelionSolR.png"
display_name = "유성 / 천상 강림"
description = "유성: 아우렐리온 솔이 땅으로 별을 떨어뜨립니다. 이 충격으로 마법 피해를 입히고 적을 기절시키며 적중한 적 챔피언 한 명당 별가루를 획득합니다. 별가루가 어느 정도 모이면 아우렐리온 솔의 다음 유성이 천상 강림으로 변합니다. / / 천상 강림: 아우렐리온 솔이 하늘에서 충돌 범위와 피해가 커진 거대한 별을 끌어내 적을 기절시키는 대신 공중에 띄웁니다. 이후 충돌 범위 가장자리에서 충격파가 퍼지며 적중한 적에게 피해를 입히고 둔화시킵니다. 별가루는 유성과 천상 강림의 충돌 범위를 넓힙니다."
