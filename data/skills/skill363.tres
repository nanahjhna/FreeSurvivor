champion_id = "Sett"
champion_name = "세트"
slot_key = "W"
reference_name = "강펀치"
reference_description = "세트가 받은 피해를 기본 지속 효과를 통해 투지로 저장합니다. 스킬 사용 시 저장한 모든 투지를 소모하여 보호막을 얻고 지정한 방향으로 펀치를 날려 중심선에 있는 적들에게 고정 피해를 입히고 중심선 밖에 있는 적들에게 물리 피해를 입힙니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/SettW.png"
display_name = "강펀치"
description = "세트가 받은 피해를 기본 지속 효과를 통해 투지로 저장합니다. 스킬 사용 시 저장한 모든 투지를 소모하여 보호막을 얻고 지정한 방향으로 펀치를 날려 중심선에 있는 적들에게 고정 피해를 입히고 중심선 밖에 있는 적들에게 물리 피해를 입힙니다."
