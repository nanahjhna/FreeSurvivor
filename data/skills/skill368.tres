reference_name = "인내의 아리아"
reference_description = "소나가 인내의 아리아를 연주하여 보호의 음률을 내보내 근처 부상 당한 아군 1명과 자신의 체력을 회복합니다. 또한 이 스킬을 사용하면 잠시 동안 오라가 생겨서 효과 범위 안의 모든 아군에게 일시적으로 보호막을 씌워줍니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/SonaW.png"
display_name = "인내의 아리아"
description = "소나가 인내의 아리아를 연주하여 보호의 음률을 내보내 근처 부상 당한 아군 1명과 자신의 체력을 회복합니다. 또한 이 스킬을 사용하면 잠시 동안 오라가 생겨서 효과 범위 안의 모든 아군에게 일시적으로 보호막을 씌워줍니다."
