reference_name = "올가미 덩굴"
reference_description = "자이라가 뒤틀린 덩굴손을 목표 위치에 소환합니다. 덩굴손은 뻗어 나가며 적들에게 피해를 입히고, 수축하면서 적들을 공중으로 띄웁니다. 덩굴손이 소환된 위치에 있는 식물들은 격분 상태가 됩니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/ZyraR.png"
display_name = "올가미 덩굴"
description = "자이라가 뒤틀린 덩굴손을 목표 위치에 소환합니다. 덩굴손은 뻗어 나가며 적들에게 피해를 입히고, 수축하면서 적들을 공중으로 띄웁니다. 덩굴손이 소환된 위치에 있는 식물들은 격분 상태가 됩니다."
