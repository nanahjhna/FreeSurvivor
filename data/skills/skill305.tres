[resource]
script = ExtResource("1_lbpah")
id = "skill305"
legacy_id = "vladimir_r"
champion_id = "Vladimir"
champion_name = "블라디미르"
slot_key = "R"
reference_name = "혈사병"
reference_description = "블라디미르가 혈사병으로 목표 지역을 오염시킵니다. 질병에 감염된 적은 일정 시간 동안 더 큰 피해를 입습니다. 감염된 적은 몇 초 뒤 마법 피해를 입으며 피해를 입은 적 챔피언 수에 비례해 블라디미르의 체력이 회복됩니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/VladimirHemoplague.png"
display_name = "혈사병"
description = "블라디미르가 혈사병으로 목표 지역을 오염시킵니다. 질병에 감염된 적은 일정 시간 동안 더 큰 피해를 입습니다. 감염된 적은 몇 초 뒤 마법 피해를 입으며 피해를 입은 적 챔피언 수에 비례해 블라디미르의 체력이 회복됩니다."
