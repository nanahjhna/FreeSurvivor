[ext_resource type="Script" path="res://scripts/resources/skill_data.gd" id="1_wn4cs"]

[resource]
script = ExtResource("1_wn4cs")
id = "skill761"
legacy_id = "kled_p"
champion_id = "Kled"
champion_name = "클레드"
slot_key = "P"
reference_name = "겁쟁이 도마뱀 스칼"
reference_description = "클레드는 듬직한 친구 스칼을 타고 다닙니다. 스칼은 클레드 대신 피해를 입고, 스칼의 체력이 모두 소진되면 클레드가 스칼에게서 내립니다. / / 스칼에게서 내리면 클레드의 스킬이 바뀌고 챔피언에 대한 피해량이 줄어듭니다. 적과 싸우면 스칼의 용기를 회복시킬 수 있습니다. 용기가 최대치에 도달하면 스칼이 일부 체력을 회복한 채 나타나 클레드를 다시 태웁니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/passive/Kled_P.png"
display_name = "겁쟁이 도마뱀 스칼"
description = "클레드는 듬직한 친구 스칼을 타고 다닙니다. 스칼은 클레드 대신 피해를 입고, 스칼의 체력이 모두 소진되면 클레드가 스칼에게서 내립니다. / / 스칼에게서 내리면 클레드의 스킬이 바뀌고 챔피언에 대한 피해량이 줄어듭니다. 적과 싸우면 스칼의 용기를 회복시킬 수 있습니다. 용기가 최대치에 도달하면 스칼이 일부 체력을 회복한 채 나타나 클레드를 다시 태웁니다."
