champion_id = "Ashe"
champion_name = "애쉬"
slot_key = "Q"
reference_name = "궁사의 집중"
reference_description = "애쉬는 공격을 계속하면 집중이 오릅니다. 집중 중첩이 최대치에 이르면 이를 모두 소모해 애쉬가 궁사의 집중을 사용할 수 있으며, 이 때 애쉬의 공격 속도가 잠시 동안 증가하고 그 동안 기본 공격이 강력한 다발 공격으로 변합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/AsheQ.png"
display_name = "궁사의 집중"
description = "애쉬는 공격을 계속하면 집중이 오릅니다. 집중 중첩이 최대치에 이르면 이를 모두 소모해 애쉬가 궁사의 집중을 사용할 수 있으며, 이 때 애쉬의 공격 속도가 잠시 동안 증가하고 그 동안 기본 공격이 강력한 다발 공격으로 변합니다."
