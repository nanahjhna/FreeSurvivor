champion_id = "TahmKench"
champion_name = "탐 켄치"
slot_key = "Q"
reference_name = "혀 채찍"
reference_description = "탐 켄치가 혀를 채찍처럼 휘둘러 처음 맞는 유닛에 피해를 입히고 속도를 늦춥니다. 적 챔피언에게 적중하면 자신의 체력을 회복합니다. / / 적 챔피언에게 절대 미각 중첩을 적용합니다. 해당 챔피언에게 절대 미각 중첩이 이미 3회 쌓였다면 챔피언은 기절하고 중첩이 소모됩니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/TahmKenchQ.png"
display_name = "혀 채찍"
description = "탐 켄치가 혀를 채찍처럼 휘둘러 처음 맞는 유닛에 피해를 입히고 속도를 늦춥니다. 적 챔피언에게 적중하면 자신의 체력을 회복합니다. / / 적 챔피언에게 절대 미각 중첩을 적용합니다. 해당 챔피언에게 절대 미각 중첩이 이미 3회 쌓였다면 챔피언은 기절하고 중첩이 소모됩니다."
