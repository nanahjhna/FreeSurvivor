reference_name = "도와줘, 픽스!"
reference_description = "아군에게 시전하면 픽스가 대상에게 점프하여 보호막을 씌워줍니다. 그 다음 대상을 따라다니며 공격을 돕습니다. 적에게 시전하면 픽스가 대상에게 점프하여 피해를 줍니다. 그 다음 대상을 따라다니며 위치를 확인할 수 있도록 해 줍니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/LuluE.png"
display_name = "도와줘, 픽스!"
description = "아군에게 시전하면 픽스가 대상에게 점프하여 보호막을 씌워줍니다. 그 다음 대상을 따라다니며 공격을 돕습니다. 적에게 시전하면 픽스가 대상에게 점프하여 피해를 줍니다. 그 다음 대상을 따라다니며 위치를 확인할 수 있도록 해 줍니다."
