reference_name = "황혼의 장막"
reference_description = "아칼리가 연막을 퍼뜨린 후 이동 속도가 잠시 상승합니다. 연막 안에 있는 동안 아칼리는 투명 상태가 되어 적이 스킬이나 공격 대상으로 지정할 수 없습니다. 아칼리가 공격하거나 스킬을 사용하면 순간적으로 아칼리의 모습이 드러납니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/AkaliW.png"
display_name = "황혼의 장막"
description = "아칼리가 연막을 퍼뜨린 후 이동 속도가 잠시 상승합니다. 연막 안에 있는 동안 아칼리는 투명 상태가 되어 적이 스킬이나 공격 대상으로 지정할 수 없습니다. 아칼리가 공격하거나 스킬을 사용하면 순간적으로 아칼리의 모습이 드러납니다."
