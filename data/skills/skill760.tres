reference_name = "총공세"
reference_description = "크산테가 적을 뒤로 밀어내며 경로에 있는 벽을 뚫고 날려 버립니다. 이후 총공세 상태에 돌입하고 적을 뒤쫓아 돌진하며, 이때 방어력이 감소하는 대신 피해량과 체력 회복량이 증가하고 변형된 스킬을 얻습니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/KSanteR.png"
display_name = "총공세"
description = "크산테가 적을 뒤로 밀어내며 경로에 있는 벽을 뚫고 날려 버립니다. 이후 총공세 상태에 돌입하고 적을 뒤쫓아 돌진하며, 이때 방어력이 감소하는 대신 피해량과 체력 회복량이 증가하고 변형된 스킬을 얻습니다."
