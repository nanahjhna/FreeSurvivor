reference_name = "태고의 마력"
reference_description = "니코가 아군 챔피언 또는 맵에 있는 다른 유닛 중 하나로 변신합니다. 이동 불가 군중 제어기에 당하거나 피해를 입히는 스킬을 사용하거나 챔피언이 아닌 상태에서 적 포탑에 피해를 입히거나 변장한 유닛의 체력만큼 피해를 입으면 변신이 풀립니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/passive/Neeko_P.png"
display_name = "태고의 마력"
description = "니코가 아군 챔피언 또는 맵에 있는 다른 유닛 중 하나로 변신합니다. 이동 불가 군중 제어기에 당하거나 피해를 입히는 스킬을 사용하거나 챔피언이 아닌 상태에서 적 포탑에 피해를 입히거나 변장한 유닛의 체력만큼 피해를 입으면 변신이 풀립니다."
