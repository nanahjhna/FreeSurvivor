reference_name = "월광 쇄도"
reference_description = "복수심에 불타는 달의 화신이 되어, 적에게 돌진하여 마법 피해를 입힙니다. / / 달빛 효과를 받고 있는 대상에게 돌진한 경우, 월광 쇄도를 즉시 한 번 더 사용할 수 있습니다. 이 때, 다른 모든 적들은 월광 쇄도의 대상이 아니었더라도 달빛 효과가 사라집니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/DianaTeleport.png"
display_name = "월광 쇄도"
description = "복수심에 불타는 달의 화신이 되어, 적에게 돌진하여 마법 피해를 입힙니다. / / 달빛 효과를 받고 있는 대상에게 돌진한 경우, 월광 쇄도를 즉시 한 번 더 사용할 수 있습니다. 이 때, 다른 모든 적들은 월광 쇄도의 대상이 아니었더라도 달빛 효과가 사라집니다."
