reference_name = "찢어 가르기"
reference_description = "암베사가 주변으로 쌍둥이 용사냥개를 휘둘러 피해를 입히고 주변 적을 둔화시킵니다. 이 스킬로 용사냥개의 발걸음이 개시되면 돌진이 끝나고 암베사가 한 번 더 일격을 가합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/AmbessaE.png"
display_name = "찢어 가르기"
description = "암베사가 주변으로 쌍둥이 용사냥개를 휘둘러 피해를 입히고 주변 적을 둔화시킵니다. 이 스킬로 용사냥개의 발걸음이 개시되면 돌진이 끝나고 암베사가 한 번 더 일격을 가합니다."
