reference_name = "속박명령"
reference_description = "스웨인이 전방으로 악마의 파동을 방출합니다. 파동은 다시 스웨인에게 돌아오며 부딪힌 적을 모두 속박합니다. 이후 속박한 챔피언을 모두 가까이 끌어당길 수 있습니다. 악의 승천 사용 중에는 이 스킬의 재사용 대기시간이 더 짧습니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/SwainE.png"
display_name = "속박명령"
description = "스웨인이 전방으로 악마의 파동을 방출합니다. 파동은 다시 스웨인에게 돌아오며 부딪힌 적을 모두 속박합니다. 이후 속박한 챔피언을 모두 가까이 끌어당길 수 있습니다. 악의 승천 사용 중에는 이 스킬의 재사용 대기시간이 더 짧습니다."
