reference_name = "수호의 고리"
reference_description = "수호의 고리로 연결된 아군 챔피언과 타릭의 방어력이 상승합니다. / / 연결된 아군 챔피언이 타릭 근처에 있는 동안 수호의 고리를 사용하면 연결된 아군에게 보호막을 씌웁니다. 타릭이 스킬을 사용하면 연결된 아군도 같은 스킬을 사용합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/TaricW.png"
display_name = "수호의 고리"
description = "수호의 고리로 연결된 아군 챔피언과 타릭의 방어력이 상승합니다. / / 연결된 아군 챔피언이 타릭 근처에 있는 동안 수호의 고리를 사용하면 연결된 아군에게 보호막을 씌웁니다. 타릭이 스킬을 사용하면 연결된 아군도 같은 스킬을 사용합니다."
