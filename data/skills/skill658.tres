reference_name = "살상연희"
reference_description = "진이 지휘봉을 휘두르며 엄청난 사거리를 지닌 한 발의 탄환을 발사합니다. 미니언과 몬스터는 관통하지만 챔피언에 맞으면 정지합니다. 적중한 대상이 좀 전에 연꽃 함정에 걸렸거나 진의 아군 또는 진에게 피해를 입었다면 속박됩니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/JhinW.png"
display_name = "살상연희"
description = "진이 지휘봉을 휘두르며 엄청난 사거리를 지닌 한 발의 탄환을 발사합니다. 미니언과 몬스터는 관통하지만 챔피언에 맞으면 정지합니다. 적중한 대상이 좀 전에 연꽃 함정에 걸렸거나 진의 아군 또는 진에게 피해를 입었다면 속박됩니다."
