[resource]
script = ExtResource("1_8kmve")
id = "skill708"
legacy_id = "khazix_w"
champion_id = "Khazix"
champion_name = "카직스"
slot_key = "W"
reference_name = "공허의 가시"
reference_description = "카직스가 폭발하는 가시를 발사하여 적중한 적에게 물리 피해를 가합니다. 폭발 범위 안에 있으면 카직스의 체력이 회복됩니다. 가시 어깨 진화를 선택하면, 공허의 가시 세 개가 원뿔 형태로 발사되며 적중한 적에게 둔화를 걸고 2초 동안 적 챔피언을 드러냅니다. 고립된 대상에게는 둔화 효과가 증가합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/KhazixW.png"
display_name = "공허의 가시"
description = "카직스가 폭발하는 가시를 발사하여 적중한 적에게 물리 피해를 가합니다. 폭발 범위 안에 있으면 카직스의 체력이 회복됩니다. 가시 어깨 진화를 선택하면, 공허의 가시 세 개가 원뿔 형태로 발사되며 적중한 적에게 둔화를 걸고 2초 동안 적 챔피언을 드러냅니다. 고립된 대상에게는 둔화 효과가 증가합니다."
