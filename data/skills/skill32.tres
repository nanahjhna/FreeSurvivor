script = ExtResource("1_adc0y")
id = "skill32"
legacy_id = "gnar_q"
champion_id = "Gnar"
champion_name = "나르"
slot_key = "Q"
reference_name = "부메랑 던지기 / 돌덩이 던지기"
reference_description = "나르가 부메랑을 던지면 맞힌 적에게 피해를 입히고 속도를 늦춘 다음 나르에게 돌아옵니다. 나르가 부메랑을 받으면 재사용 대기시간이 감소합니다. / / 메가 나르는 돌덩어리를 던져 주위 모두에게 피해를 입히고 속도를 늦춥니다. 던져진 돌덩어리는 적에게 맞으면 그 자리에 멈추며, 메가 나르가 다시 집어들면 재사용 대기시간이 감소합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/GnarQ.png"
display_name = "부메랑 던지기 / 돌덩이 던지기"
description = "나르가 부메랑을 던지면 맞힌 적에게 피해를 입히고 속도를 늦춘 다음 나르에게 돌아옵니다. 나르가 부메랑을 받으면 재사용 대기시간이 감소합니다. / / 메가 나르는 돌덩어리를 던져 주위 모두에게 피해를 입히고 속도를 늦춥니다. 던져진 돌덩어리는 적에게 맞으면 그 자리에 멈추며, 메가 나르가 다시 집어들면 재사용 대기시간이 감소합니다."
