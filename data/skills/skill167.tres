script = ExtResource("1_6k6tn")
id = "skill167"
legacy_id = "leblanc_q"
champion_id = "Leblanc"
champion_name = "르블랑"
slot_key = "Q"
reference_name = "악의의 인장"
reference_description = "르블랑이 인장을 날려 대상에게 피해를 주고 3.5초 동안 표식을 남깁니다. 표식이 남은 대상을 스킬로 공격하면 인장이 폭발하며 추가 피해를 입힙니다. 인장이 명중하거나 폭발해 대상을 처치하면 소모한 마나를 돌려받고 이 스킬의 남은 재사용 대기시간이 감소합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/LeblancQ.png"
display_name = "악의의 인장"
description = "르블랑이 인장을 날려 대상에게 피해를 주고 3.5초 동안 표식을 남깁니다. 표식이 남은 대상을 스킬로 공격하면 인장이 폭발하며 추가 피해를 입힙니다. 인장이 명중하거나 폭발해 대상을 처치하면 소모한 마나를 돌려받고 이 스킬의 남은 재사용 대기시간이 감소합니다."
