reference_name = "달빛 낙하"
reference_description = "다이애나가 주위 모든 적을 드러내 끌어당긴 다음 이동 속도를 늦춥니다. / / 다이애나가 한 명 이상의 적 챔피언을 끌어당기면 잠시 후 달빛을 받아 자신의 주변 지역에 마법 피해를 입힙니다. 이 효과는 적 한 명을 추가로 끌어당길 때마다 피해량이 증가합니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/DianaR.png"
