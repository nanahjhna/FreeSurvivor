champion_id = "Talon"
champion_name = "탈론"
slot_key = "Q"
reference_name = "녹서스식 외교"
reference_description = "탈론이 대상 유닛을 찌릅니다. 근접 공격이 가능한 거리에서 사용하면 치명타가 적용됩니다. 근접 공격이 불가능한 거리에서 사용하면 대상에게 도약해서 찌릅니다. 이 스킬로 대상을 처치하면 체력을 약간 회복하고 재사용 대기시간을 일부 돌려받습니다."
icon_url = "https://ddragon.leagueoflegends.com/cdn/16.22.1/img/spell/TalonQ.png"
display_name = "녹서스식 외교"
description = "탈론이 대상 유닛을 찌릅니다. 근접 공격이 가능한 거리에서 사용하면 치명타가 적용됩니다. 근접 공격이 불가능한 거리에서 사용하면 대상에게 도약해서 찌릅니다. 이 스킬로 대상을 처치하면 체력을 약간 회복하고 재사용 대기시간을 일부 돌려받습니다."
